{% extends "partials/base.html.twig" %}

{% block navbar %}
    {% include 'partials/navbar-fluid.html.twig' %}
{% endblock %}

{% block content %}
<div class="bg-white-neutral pb-5">
    <div style="background:linear-gradient(to bottom right, rgba(200, 250, 209, .5), rgba(155, 190, 250, .3));padding-bottom:5rem">
        <div class="container-xxl">
            <div class="row py-5">
                <div class="px-3">
                    <h1 class="text-slate-700 fw-bolder my-4">Contact Us</h1>
                    <p class="text-slate-800 mb-0">Questions, feedback, and collaboration ideas are always welcome.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container d-flex pb-5 justify-content-center">
        <div class="shadow bg-white-cool rounded-0 px-4 px-md-5 py-5 w-100" style="margin-top:-4.5rem;max-width:48rem">
            <div class="row align-items-center g-5">
                <div class="col-md-7">
                    <h2 class="text-slate-700 mb-3">Get in touch</h2>
                    <p class="text-slate-600 mb-3">We'd be glad to hear from you about:</p>
                    <ul class="text-slate-600 mb-0 ps-3">
                        <li class="mb-2">Forecasts, data, or methodology</li>
                        <li class="mb-2">API access and technical questions</li>
                        <li>Research, press, or partnership inquiries</li>
                    </ul>
                </div>
                <div class="col-md-5 text-center">
                    <a class="btn bg-sky-dark text-slate-200 bg-hover-sky px-5 rounded-0 mb-3" href="mailto:charles@{{ site }}.com">Email us</a>
                    <div class="text-sm">
                        <a href="mailto:charles@{{ site }}.com">charles@{{ site }}.com</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
