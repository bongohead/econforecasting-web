{% extends "partials/base.html.twig" %}

{% block meta %}
<meta name="description" content="Our blog features macroecononomic commentary, research, and forecasts from economists and data scientists."/>
<link rel="canonical" href="https://macropredictions.com/blog">
{% endblock %}

{% block staticlinks %}
{% endblock %}

{% block navbar %}
	{% include 'partials/navbar-fluid.html.twig' %}
{% endblock %}


{% block content %}
<div class="bg-white pb-5 pt-1">
	<div class="container-xxl px-sm-5 px-md-4">
		<div class="row justify-content-center mt-5">
			<div class="col-12 col-md-11 col-lg-10 col-xxl-9" >
				{{ banner_blog_post }}
				<hr style="border-top:1px solid var(--slate-200)" class="mt-3 mb-5">
			</div>
		</div>
		
		<div class="row justify-content-center">

			<div class="col-md-8 col-lg-7 col-xxl-6 blog-posts-container ">
				<div>
					{{ blog_posts }}
				</div>
				<div class="blog-pagination d-flex justify-content-center mt-5">
					{{ pagination }}
				</div>
			</div>

			<div class="d-none d-md-block ps-md-4 col-md-3 blog-sidebar ">
				{# <div class="mb-5 bg-white-neutral rounded px-3 py-3">
					<h6 class="text-slate-400 fw-bolder">ABOUT</h6>
					<p class="mb-0">Our latest commentary, analysis and data on economic forecasting, with a focus on the technical side of modeling and macroeconomics.</p>
				</div> #}


				<div class="bg-white-cool px-4 py-4">
					<h6 class="text-slate-800">About</h6>
					<p class="mb-5 text-sm text-slate-600">Our latest commentary, analysis and data on economic forecasting, with a focus on the technical side of modeling and macroeconomics.</p>

					<div class="text-slate-800 pt-3"><span class="fs-6">Filter Results</span>{{ clear_filters }}</div>

					<div class="text-sm mt-3 mb-2 text-slate-500 fw-bold text-sm">Topic</div>
					<div class="d-flex flex-wrap row-gap-2 column-gap-2">
						{{ topics }}
					</div>
					<div class="text-sm mt-4 mb-2 text-slate-500 fw-bold text-sm">Dates</div>
					<div class="d-flex flex-wrap row-gap-2 column-gap-2">
						{{ years }}
					</div>
				</div>		
			</div>


		</div>
	</div>
</div>
 {% endblock %}