{
  "name": "macropredictions",
  "version": "2.0.0",
  "private": true,
  "description": "EconForecasting and MacroPredictions public website",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:css": "sass --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions --silence-deprecation=abs-percent --silence-deprecation=if-function ../scss/main.scss static/css/style.css",
    "build:js": "NODE_ENV=production BUILD_ONLY=true node app.js",
    "start": "node app.js",
    "test": "node --test",
    "check": "node --check app.js && node --check middleware.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.4",
    "twig": "^3.0.0"
  },
  "devDependencies": {
    "sass": "^1.102.0"
  }
}
